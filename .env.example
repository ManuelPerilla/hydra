# Copy to .env and generate your own values; bootstrap generates them locally.
HYDRA_POSTGRES_PASSWORD=replace-with-random-secret
HYDRA_AGENT_TOKEN=replace-with-at-least-32-random-characters
HYDRA_DATA_PROTECTION_KEY=replace-with-base64-encoded-32-random-bytes
HYDRA_AUTH_MODE=local
HYDRA_GITHUB_CLIENT_ID=
HYDRA_GITHUB_CLIENT_SECRET=
HYDRA_ALLOWED_GITHUB_IDS=
HYDRA_PUBLIC_URL=http://localhost:8080
# X is never required for Zero-Cost.
HYDRA_X_ENABLED=false
